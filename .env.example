# Copy to .env for local runs, or set these in your deployment environment.
# .env is gitignored; .env.example is committed.

# Shared secret clients send in the `X-API-Key` header on every /notes request.
# If unset, the app falls back to a non-secret dev key (see app/auth.py).
API_KEY=change-me-to-a-long-random-string

# Optional: override where the SQLite file lives.
# DATABASE_URL=sqlite:///./notes.db
